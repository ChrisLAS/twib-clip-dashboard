{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "twib-mcp-probe",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "PROBE_ORIGIN": "https://probe.invalid",
    "APP_VERSION": "mcp-probe-0.1.0",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "OWNER_EMAIL": "",
    "OWNER_OPAQUE_ID": "",
    "ALLOWED_REDIRECT_URIS": "",
  },
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" },
  ],
  "durable_objects": {
    "bindings": [{ "name": "REPLAY_GUARD", "class_name": "ReplayGuard" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReplayGuard"] }],
  "observability": { "enabled": false },
}

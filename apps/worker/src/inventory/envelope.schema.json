{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:number-one:twib-inventory-envelope:v2",
  "title": "Number One immutable inventory transport envelope v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scan_id",
    "sequence",
    "manifest"
  ],
  "properties": {
    "schema": {
      "const": "number-one-inventory-envelope/v2"
    },
    "scan_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "manifest": {
      "$ref": "urn:number-one:twib-inventory:v1"
    }
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types", "node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "apps/worker/**/*.ts",
    "packages/shared/**/*.ts",
    "packages/matching/**/*.ts",
    "security-review/**/*.ts"
  ]
}

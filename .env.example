# Documentation only. Wrangler reads apps/worker/.dev.vars for local secrets.
# Production values must be configured as approved Worker vars/secrets.
# No live credentials, OAuth client, or grant are included.
APP_ENV=production
APP_ORIGIN=https://review.example.invalid
ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
ACCESS_AUD=approved-access-application-audience
OWNER_EMAIL=owner@example.invalid
# CSRF_SECRET=<securely generated after approval>
# GOOGLE_CLIENT_ID=<approved client>
# GOOGLE_CLIENT_SECRET=<secret>
# GOOGLE_REFRESH_TOKEN=<approved grant>
# PRODUCER_SHEET_ID=<approved private Sheet>
# PRODUCER_SHEET_RANGE=Manifests!A2:A101
# ALLOWED_EPISODE_IDS=ep-demo
# ALLOWED_DRIVE_FOLDER_IDS=<approved immediate parent folder IDs>
